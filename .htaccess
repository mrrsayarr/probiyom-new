RewriteEngine On
RewriteRule ^404\.html$ - [R=404,L]

# Keep generated crawl documents private; they are available only through clean URLs.
RewriteCond %{ENV:REDIRECT_STATUS} !^404$
RewriteCond %{THE_REQUEST} \s/+seo-pages(?:[/\s?]) [NC]
RewriteRule ^seo-pages(?:/|$) - [R=404,L,NC]

# Preserve the standalone demo's directory-index URL while html_handling is disabled.
RewriteRule ^st/?$ st/index.html [END]
RewriteRule ^index\.html$ / [R=308,L,NE]

# Canonical clean URLs do not include a trailing slash.
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/+$ /$1 [R=308,L,NE]

# Serve the pre-rendered root and route documents internally.
RewriteRule ^$ seo-pages/index.html [END]
RewriteCond %{DOCUMENT_ROOT}/seo-pages/$1/index.html -f
RewriteRule ^(.+)$ seo-pages/$1/index.html [END]

# Leave real files to Apache. Unknown paths return an actual 404 document/status.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [END]
ErrorDocument 404 /seo-pages/404.html
